# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# claude code local context (PRD copies, source assets, screenshots)
.claude/

# playwright mcp local snapshots/logs from browser testing
.playwright-mcp/

# Playwright MCP 가 screenshot 을 프로젝트 루트에 떨어뜨려서 임시 스캔 결과가 git status 에
# 잡힌다. 루트의 PNG 는 모두 ephemeral 검증 산출물이라 commit 금지.
/*.png
